# Application
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL (SQLAlchemy + psycopg 3) — app database on host port 5432
DATABASE_URL=postgresql+psycopg://conduct:conduct@localhost:5432/conduct

# Redis
REDIS_URL=redis://localhost:6379/0

# Invites and pagination
INVITE_EXPIRY_HOURS=72
MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=20

# Tests use the separate postgres_test service on host port 5435
# (see tests/conftest.py). CI uses its own service container on 5432.

# Used by docker-compose for the API container (override hostnames)
# DATABASE_URL=postgresql+psycopg://conduct:conduct@postgres:5432/conduct
# REDIS_URL=redis://redis:6379/0
